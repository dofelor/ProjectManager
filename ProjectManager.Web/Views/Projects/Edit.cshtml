@model ProjectManager.Logic.Dtos.ProjectDTO
<div asp-validation-summary="All" class="text-danger"></div>

<h2>Редактирование проекта: @Model.Name</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

    <div class="row">
        <div class="col-md-6">
            <h4>Информация о проекте</h4>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Название проекта</label>
                <input asp-for="Name" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="CustomerCompany" class="form-label">Компания-заказчик</label>
                <input asp-for="CustomerCompany" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="PerformingCompany" class="form-label">Компания-исполнитель</label>
                <input asp-for="PerformingCompany" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Priority" class="form-label">Приоритет (число)</label>
                <input asp-for="Priority" type="number" class="form-control" min="1" max="100" />
                <small class="text-muted">Чем выше число, тем выше проект в списке при сортировке.</small>
            </div>

            <div class="mb-3">
                <label asp-for="StartDate" class="form-label">Дата начала</label>
                <input asp-for="StartDate" type="date" class="form-control"
                       value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="mb-3">
                <label asp-for="EndDate" class="form-label">Дата окончания</label>
                <input asp-for="EndDate" type="date" class="form-control"
                       value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="mb-3">
                <label asp-for="SupervisorId" class="form-label">Руководитель</label>
                <select asp-for="SupervisorId" class="form-select"
                        asp-items="@(new SelectList(ViewBag.Employees, "Id", "FullName"))">
                </select>
            </div>
        </div>

        <div class="col-md-6">
            <h4>Команда проекта</h4>
            <div class="mb-3">
                <label class="form-label">Добавить сотрудника (поиск)</label>
                <input type="text" id="employeeSearch" class="form-control" placeholder="Введите имя...">
                <div id="allEmployeesContainer" class="border p-2 mt-2" style="max-height: 150px; overflow-y: auto;">
                    @foreach (var emp in (IEnumerable<ProjectManager.Logic.Dtos.EmployeeDTO>)ViewBag.Employees)
                    {
                        <div class="employee-item p-1" data-name="@emp.FullName.ToLower()" data-id="@emp.Id" style="cursor:pointer;">
                            <span class="badge bg-light text-dark">+ @emp.FullName</span>
                        </div>
                    }
                </div>
            </div>

            <h5>Текущий состав:</h5>
            <ul id="selectedEmployeesList" class="list-group">
                @if (Model.Employees != null)
                {
                    foreach (var emp in Model.Employees)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @emp.LastName @emp.FirstName
                            <input type="hidden" name="employeeIds" id="emp-input-@emp.Id" value="@emp.Id" />
                            <button type="button" class="btn btn-outline-danger btn-sm remove-emp">Удалить</button>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Сохранить</button>

        <a href="@(string.IsNullOrEmpty(ViewBag.ReturnUrl) ? Url.Action("Index") : ViewBag.ReturnUrl)"
           class="btn btn-outline-secondary">Отмена</a>
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Поиск
            $("#employeeSearch").on("keyup", function() {
                var value = $(this).val().toLowerCase();
                $("#allEmployeesContainer .employee-item").filter(function() {
                    $(this).toggle($(this).data("name").indexOf(value) > -1);
                });
            });

            // Добавление (исправлено получение имени)
            $(document).on("click", ".employee-item", function() {
                let id = $(this).data("id");
                let name = $(this).find('.badge').text().replace('+', '').trim();

                if ($(`#emp-input-${id}`).length === 0) {
                    $("#selectedEmployeesList").append(`
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    ${name}
                                    <input type="hidden" name="employeeIds" id="emp-input-${id}" value="${id}" />
                                    <button type="button" class="btn btn-outline-danger btn-sm remove-emp">Удалить</button>
                                </li>
                            `);
                }
                $("#employeeSearch").val("").keyup();
            });

            // Удаление
            $(document).on("click", ".remove-emp", function() {
                $(this).closest("li").remove();
            });
        });
    </script>
}