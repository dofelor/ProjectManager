@model ProjectManager.Logic.Dtos.ProjectDTO

<div class="container mt-4">
    <div class="card shadow mb-4">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">Проект: @Model.Name</h4>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Заказчик:</strong> @Model.CustomerCompany</p>
                    <p><strong>Исполнитель:</strong> @Model.PerformingCompany</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Старт:</strong> @Model.StartDate?.ToShortDateString()</p>
                    <p><strong>Финиш:</strong> @Model.EndDate?.ToShortDateString()</p>
                    <p><strong>Приоритет:</strong> <span class="badge bg-primary">@Model.Priority</span></p>
                </div>
            </div>
        </div>
    </div>

    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Все проекты</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    @* Секция с задачами этого проекта *@
    <div class="card shadow">
    <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Задачи проекта</h5>
            <a asp-controller="Tasks" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-sm btn-light">
                <i class="bi bi-plus-lg"></i> Добавить задачу
            </a>
        </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Задача</th>
                    <th>Исполнитель</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in (IEnumerable<ProjectManager.Logic.Dtos.ProjectTaskDTO>)ViewBag.ProjectTasks)
                {
                    <tr>
                        <td class="align-middle">@task.Name</td>
                        <td class="align-middle">@task.ExecutorFullName</td>
                        <td class="align-middle">
                            @switch (task.Status)
                            {
                                case 0: <span class="badge bg-info text-dark">ToDo</span> break;
                                case 1: <span class="badge bg-warning text-dark">In Progress</span> break;
                                case 2: <span class="badge bg-success">Done</span> break;
                            }
                        </td>
                            <td class="align-middle text-end">
                                <div class="btn-group btn-group-sm mr-2">
                                    @* Добавляем параметр returnUrl, чтобы Edit знал, куда возвращать *@
                                    <a asp-controller="Tasks" asp-action="Edit" asp-route-id="@task.Id"
                                       asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                                       class="btn btn-outline-primary">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @* Добавляем параметр returnUrl, чтобы кнопка "Назад" в Details сработала верно *@
                                    <a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.Id"
                                       asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                                       class="btn btn-outline-info">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <form asp-controller="Tasks" asp-action="Delete" asp-route-id="@task.Id" method="post">
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Удалить?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>