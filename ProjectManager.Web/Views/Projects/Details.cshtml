@model ProjectManager.Logic.Dtos.ProjectDTO
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Детали проекта";
    var currentUserId = UserManager.GetUserId(User);

    // Определяем права доступа
    bool isAdmin = User.IsInRole("Admin");

    // ВАЖНО: Сравниваем SupervisorUserId из DTO с ID текущего пользователя
    bool isProjectSupervisor = User.IsInRole("ProjectManager") &&
                               !string.IsNullOrEmpty(Model.SupervisorUserId) &&
                               Model.SupervisorUserId.Equals(currentUserId, System.StringComparison.OrdinalIgnoreCase);

    // Может ли текущий пользователь редактировать проект и добавлять задачи?
    bool canManageProject = isAdmin || isProjectSupervisor;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="alert alert-secondary">
            Текущий пользователь: @currentUserId <br />
            ID руководителя проекта: @Model.SupervisorUserId <br />
            Это мой проект: @(Model.SupervisorUserId == currentUserId)
        </div>
        <h1>Проект: @Model.Name</h1>
        <div>
            @if (canManageProject)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                    <i class="bi bi-pencil"></i> Редактировать проект
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">Назад к списку</a>
        </div>
    </div>

    <div class="row">
        @* Основная информация о проекте *@
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Информация</h5>
                </div>
                <div class="card-body">
                    <p><strong>Заказчик:</strong> @Model.CustomerCompany</p>
                    <p><strong>Исполнитель:</strong> @Model.PerformingCompany</p>
                    <p><strong>Руководитель:</strong> @Model.SupervisorFullName</p>
                    <p><strong>Приоритет:</strong> <span class="badge bg-info text-dark">@Model.Priority</span></p>
                    <p><strong>Начало:</strong> @Model.StartDate?.ToShortDateString()</p>
                    <p><strong>Конец:</strong> @Model.EndDate?.ToShortDateString()</p>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Команда проекта</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        @foreach (var emp in Model.Employees)
                        {
                            <li><i class="bi bi-person"></i> @emp.LastName @emp.FirstName</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        @* Список задач *@
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Задачи проекта</h5>
                    @if (canManageProject)
                    {
                        <a asp-controller="Tasks"
                           asp-action="Create"
                           asp-route-projectId="@Model.Id"
                           class="btn btn-sm btn-success">
                            <i class="bi bi-plus-lg"></i> Добавить задачу
                        </a>
                    }
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Название</th>
                                <th>Исполнитель</th>
                                <th>Статус</th>
                                <th class="text-end">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.ProjectTasks != null)
                            {
                                foreach (var task in (IEnumerable<ProjectManager.Logic.Dtos.ProjectTaskDTO>)ViewBag.ProjectTasks)
                                {
                                    <tr>
                                        <td>@task.Name</td>
                                        <td>@task.ExecutorFullName</td>
                                        <td>
                                            @* Тут можно добавить разные цвета для статусов *@
                                            <span class="badge bg-secondary">@task.Status</span>
                                        </td>
                                        <td class="text-end">
                                            @* Логика доступа к редактированию задачи:
                                               1. Админ или Менеджер этого проекта могут редактировать любую задачу.
                                               2. Сотрудник может редактировать (менять статус) только если он исполнитель.
                                            *@
                                            @if (canManageProject || task.ExecutorUserId == currentUserId)
                                            {
                                                <a asp-controller="Tasks" asp-action="Edit" asp-route-id="@task.Id"
                                                   asp-route-returnUrl="@Context.Request.Path"
                                                   class="btn btn-sm btn-outline-warning">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }

                                            @if (canManageProject)
                                            {
                                                <form asp-controller="Tasks" asp-action="Delete" asp-route-id="@task.Id"
                                                      asp-route-returnUrl="@Context.Request.Path" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            onclick="return confirm('Удалить задачу?')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted p-4">Задач пока нет</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>