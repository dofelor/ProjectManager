@model ProjectManager.Logic.Dtos.ProjectTaskDTO

@{
    ViewData["Title"] = "Создать задачу";
}
<div asp-validation-summary="All" class="text-danger"></div>
<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Новая задача</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>


                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label asp-for="Name" class="form-label">Название задачи</label>
                        <input asp-for="Name" class="form-control" placeholder="Введите краткое название" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ProjectId" class="form-label">Проект</label>
                        <select asp-for="ProjectId" class="form-select" asp-items="ViewBag.ProjectId">
                            <option value="">-- Выберите проект --</option>
                        </select>
                        <span asp-validation-for="ProjectId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Priority" class="form-label">Приоритет (целое число)</label>
                        <input asp-for="Priority" type="number" class="form-control" />
                        <span asp-validation-for="Priority" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AuthorId" class="form-label">Автор (кто поставил)</label>
                        <select asp-for="AuthorId" class="form-select" asp-items="ViewBag.AuthorId">
                            <option value="">-- Выберите автора --</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ExecutorId" class="form-label">Исполнитель</label>
                        <select asp-for="ExecutorId" class="form-select" asp-items="ViewBag.ExecutorId">
                            <option value="">-- Выберите исполнителя --</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label">Статус</label>
                        <select asp-for="Status" class="form-select">
                            <option value="0">ToDo</option>
                            <option value="1">In Progress</option>
                            <option value="2">Done</option>
                        </select>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="Comment" class="form-label">Комментарий</label>
                        <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Comment" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary px-4">Создать</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>