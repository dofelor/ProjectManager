@model ProjectManager.Logic.Dtos.ProjectTaskDTO

@{
    ViewData["Title"] = "Редактирование задачи";
    // Employee can only change status.
    // Admin and Project Manager (of this project) can change everything.
    bool isEmployee = User.IsInRole("Employee");
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Редактирование задачи</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                @* Save returnUrl to return where we came from (e.g., project details) *@
                <input type="hidden" name="returnUrl" value="@ViewContext.HttpContext.Request.Query["returnUrl"]" />

                @* Data protection: if fields are disabled, pass them via hidden *@
                @if (isEmployee)
                {
                    <input type="hidden" asp-for="Name" />
                    <input type="hidden" asp-for="ProjectId" />
                    <input type="hidden" asp-for="Priority" />
                    <input type="hidden" asp-for="AuthorId" />
                    <input type="hidden" asp-for="ExecutorId" />
                    @* If comment also cannot be changed by employee: *@
                    <input type="hidden" asp-for="Comment" />
                }

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    @* Name *@
                    <div class="col-md-12 mb-3">
                        <label asp-for="Name" class="form-label">Название задачи</label>
                        <input asp-for="Name" class="form-control" readonly="@isEmployee" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    @* Project *@
                    <div class="col-md-6 mb-3">
                        <label asp-for="ProjectId" class="form-label">Проект</label>
                        <select asp-for="ProjectId" class="form-select" asp-items="ViewBag.ProjectId" disabled="@isEmployee">
                            <option value="">-- Выберите проект --</option>
                        </select>
                    </div>

                    @* Priority *@
                    <div class="col-md-6 mb-3">
                        <label asp-for="Priority" class="form-label">Приоритет</label>
                        <input asp-for="Priority" type="number" class="form-control" readonly="@isEmployee" />
                    </div>

                    @* Author *@
                    <div class="col-md-6 mb-3">
                        <label asp-for="AuthorId" class="form-label">Автор</label>
                        <select asp-for="AuthorId" class="form-select" asp-items="ViewBag.AuthorId" disabled="@isEmployee">
                        </select>
                    </div>

                    @* Executor *@
                    <div class="col-md-6 mb-3">
                        <label asp-for="ExecutorId" class="form-label">Исполнитель</label>
                        <select asp-for="ExecutorId" class="form-select" asp-items="ViewBag.ExecutorId" disabled="@isEmployee">
                        </select>
                    </div>

                    @* STATUS - available to all *@
                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label text-primary fw-bold">Статус задачи</label>
                        <select asp-for="Status" class="form-select border-primary fw-bold">
                            <option value="0">ToDo</option>
                            <option value="1">In Progress</option>
                            <option value="2">Done</option>
                        </select>
                    </div>

                    @* Comment *@
                    <div class="col-md-12 mb-3">
                        <label asp-for="Comment" class="form-label">Комментарий</label>
                        <textarea asp-for="Comment" class="form-control" rows="3" readonly="@isEmployee"></textarea>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save"></i> Сохранить
                    </button>
                    <a href="@(string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["returnUrl"]) ? Url.Action("Index") : ViewContext.HttpContext.Request.Query["returnUrl"])"
                       class="btn btn-outline-secondary px-4">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>