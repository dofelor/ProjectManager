@model ProjectManager.Logic.Dtos.EmployeeDTO

@{
    ViewData["Title"] = "Редактировать сотрудника";
}

<h2>Редактировать профиль сотрудника</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" /> @* Важно сохранить связь с аккаунтом *@

            <div class="mb-3">
                <label asp-for="LastName" class="form-label">Фамилия</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FirstName" class="form-label">Имя</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" readonly />
                <small class="text-muted">Email нельзя менять, так как он привязан к логину.</small>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-success">Сохранить изменения</button>
                <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
            </div>
        </form>
    </div>
</div>